{
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/.next",
      "!**/out",
      "!**/.vercel",
      "!**/coverage",
      "!**/next-env.d.ts",
      "!**/tests/.results",
      "!**/test-results",
      "!**/playwright-report",
      "!**/.evals",
      "!**/.wrangler",
      "!**/bun.lock",
      "!contracts",
      "!content",
      "!public"
    ]
  },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 120 },
  "javascript": { "formatter": { "quoteStyle": "single", "semicolons": "always" } },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "complexity": { "noExcessiveCognitiveComplexity": "warn" },
      "correctness": {
        "noUnusedImports": "error",
        "noUnusedVariables": "error",
        "noUnusedFunctionParameters": "warn"
      },
      "suspicious": {
        "noExplicitAny": "warn"
      }
    }
  },
  "overrides": [
    {
      "includes": ["worker/domain/**", "src/content/rules/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "next": "domain/rules khong import next (C7, design.md §3)",
                  "sharp": "domain/rules khong import sharp — di qua port/scripts",
                  "markdown-it": "domain/rules khong import markdown-it truc tiep"
                },
                "patterns": [
                  {
                    "group": ["next/*", "cloudflare:*", "@cloudflare/*"],
                    "message": "domain/rules khong import framework/runtime (C7)"
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
