{
  "name": "gms-hungyen-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "bun run scripts/dev/sync-images.ts && next dev",
    "mock": "bun run scripts/dev/sync-images.ts && NEXT_PUBLIC_API_MOCK=1 next dev",
    "content-check": "bun run scripts/content/check.ts",
    "build": "bun run scripts/content/build-site.ts",
    "build:e2e": "bun run tests/support/build-e2e-site.ts",
    "deploy-prod": "bun run scripts/deploy/deploy-prod.ts",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "vitest run --passWithNoTests",
    "e2e": "playwright test --config tests/playwright.config.ts --project acceptance",
    "perf": "playwright test --config tests/playwright.config.ts --project perf",
    "db:migrate:test": "bun x wrangler d1 execute gms_contact --local --config wrangler.test.jsonc --file=contracts/d1-schema.sql"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "clsx": "^2.1.1",
    "lucide-react": "^1.57.0",
    "markdown-it": "^15.0.0",
    "next": "16.4.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.34.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "yaml": "^2.8.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@biomejs/biome": "^2.2.0",
    "@cloudflare/workers-types": "^4.20250214.0",
    "@playwright/test": "^1.64.1",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "5.0.5",
    "happy-dom": "^21.0.4",
    "lighthouse": "^12.4.0",
    "playwright": "^1.64.1",
    "typescript": "^5.9.0",
    "vitest": "5.0.5",
    "wrangler": "4.151.1"
  }
}
