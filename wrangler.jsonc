{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gms-contact",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-19",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "drop-trailing-slash",
    "run_worker_first": ["/api/*"]
  },
  "triggers": {
    "crons": ["* * * * *", "5 17 * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gms_contact",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  "vars": {
    "FORM_ENABLED": "true",
    "POLICY_VERSION": "1.0",
    "SITE_ORIGIN": "https://gmshungyen.vn",
    "MAIL_FROM": "thongbao@thongbao.gmshungyen.vn",
    "ALERT_TO": "kythuat@gmshungyen.vn"
  },
  // Staging trên workers.dev khi chưa có tên miền: không có send_email nên form đóng, không Cron gửi thư.
  "env": {
    "staging": {
      "workers_dev": true,
      "triggers": {
        "crons": []
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "gms_contact_staging",
          "database_id": "ac1ec737-a517-4eca-b822-c3e51847a51c"
        }
      ],
      "vars": {
        "FORM_ENABLED": "false",
        "CONTACT_MAIL_READY": "false",
        "POLICY_VERSION": "1.0",
        "SITE_ORIGIN": "https://gms-contact-staging.bongmedia-web.workers.dev",
        "MAIL_FROM": "thongbao@thongbao.gmshungyen.vn",
        "ALERT_TO": "kythuat@gmshungyen.vn"
      }
    }
  }
}
